<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Authors>GeneralZip</Authors>
    <Version>1.2.0</Version>
    <Company>GeneralZip</Company>
    <Product>GeneralZip</Product>
    <!-- Deterministic CI build; inject the commit hash via MinVer-style CI_VERSION if present -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
