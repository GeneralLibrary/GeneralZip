<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GeneralZip.Bench</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeneralZip\GeneralZip.csproj" />
  </ItemGroup>

  <!-- 本地构建时携带 cargo 产物 -->
  <ItemGroup>
    <Content Include="..\..\native\generalzip-native\target\release\generalzip_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false"
             Condition="Exists('..\..\native\generalzip-native\target\release\generalzip_native.dll')" />
  </ItemGroup>

</Project>
