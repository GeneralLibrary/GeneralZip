<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>GeneralZip</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>跨格式压缩组件：ZIP/7z/RAR/TAR/GZ/BZ2/XZ/Zstd/LZ4，支持 ZipCrypto、WinZip AES、国密 SM4-GM 加密与事件驱动 API。</Description>
    <PackageTags>zip;7z;rar;compression;archive;sm4;国密;encryption;tar;gzip;zstd;lz4</PackageTags>
    <RepositoryUrl>https://github.com/GeneralZip/GeneralZip</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- 设计约束：除微软官方维护的包外，不引入任何第三方 NuGet。
         国密（SM3/SM4/HMAC/PBKDF2-SM3）与 TAR/GZip 容器为本组件纯 C# 实现；
         bzip2/xz/zstd/lz4 编解码经 Rust 原生核心（GeneralZip.Native）。 -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeneralZip.Tests" />
    <InternalsVisibleTo Include="GeneralZip.Native.Tests" />
  </ItemGroup>

</Project>
