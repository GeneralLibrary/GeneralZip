<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>GeneralZip</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Cross-format compression library for .NET: ZIP/7z/RAR/TAR/GZ/BZ2/XZ/Zstd/LZ4 with ZipCrypto, WinZip AES, Chinese national crypto (SM4-GM) and an event-driven API. 跨格式压缩组件：ZIP/7z/RAR/TAR/GZ/BZ2/XZ/Zstd/LZ4，支持 ZipCrypto、WinZip AES、国密 SM4-GM 加密与事件驱动 API。</Description>
    <PackageTags>zip;7z;rar;compression;archive;sm4;guomi;encryption;tar;gzip;zstd;lz4;bzip2;xz</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/GeneralLibrary/GeneralZip.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/GeneralLibrary/GeneralZip</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design constraint: no third-party NuGet dependencies other than Microsoft-maintained
         packages. SM3/SM4/SM-HMAC/PBKDF2-SM3 and the TAR/GZip containers are pure C# in this
         project; bzip2/xz/zstd/lz4 codecs go through the Rust native core (GeneralZip.Native). -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeneralZip.Tests" />
    <InternalsVisibleTo Include="GeneralZip.Native.Tests" />
  </ItemGroup>

</Project>
